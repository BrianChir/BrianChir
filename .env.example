# Copy this file to .env and fill in your credentials.
# The server automatically loads .env if present.

# Optional: override the port the HTTP server listens on (defaults to 3000)
# PORT=3000

# Required for AI-generated answers. If omitted the server falls back to citation-only responses.
# OPENAI_API_KEY=sk-your-key-here

# Optional: override the OpenAI chat model (defaults to gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Scraper tuning
# MAX_PAGES=20
# REQUEST_DELAY_MS=500
